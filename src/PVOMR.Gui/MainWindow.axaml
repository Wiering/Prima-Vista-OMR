<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:PVOMR.Gui"
        x:Class="PVOMR.Gui.MainWindow"
        Title="PVOMR – score correction"
        Width="1500" Height="950"
        WindowStartupLocation="CenterScreen">
  <Window.Styles>
    <Style Selector="TextBlock.h">
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Margin" Value="0,10,0,2"/>
    </Style>
    <Style Selector="TextBlock.lbl">
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Margin" Value="0,0,8,0"/>
    </Style>
    <Style Selector="Button.tool">
      <Setter Property="Padding" Value="8,4"/>
    </Style>
    <Style Selector="WrapPanel > :is(Control)">
      <Setter Property="Margin" Value="0,0,6,4"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
  </Window.Styles>

  <DockPanel>
    <WrapPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="6,6,6,2">
      <Button Name="OpenButton" Classes="tool" Content="Open…"/>
      <TextBlock Classes="lbl" Text="page" Margin="4,0,2,0"/>
      <Button Name="PrevButton" Classes="tool" Content="◀"/>
      <NumericUpDown Name="PageBox" Minimum="1" Maximum="1" Value="1" Increment="1" FormatString="0" Width="60" ShowButtonSpinner="False" HorizontalContentAlignment="Center"/>
      <Button Name="NextButton" Classes="tool" Content="▶"/>
      <TextBlock Name="PageLabel" VerticalAlignment="Center" MinWidth="50" Margin="4,0,0,0" Text="no file"/>
      <TextBlock Classes="lbl" Text="DPI" Margin="12,0,4,0"/>
      <NumericUpDown Name="DpiBox" Minimum="100" Maximum="900" Increment="50" Value="300" Width="120" FormatString="0"/>
      <Button Name="RecognizeButton" Classes="tool" Content="Recognise again"/>
      <Button Name="RecognizeAllButton" Classes="tool" Content="Recognise all pages"/>
      <Button Name="UndoButton" Classes="tool" Content="Undo (Ctrl+Z)"/>
      <Button Name="ExportButton" Classes="tool" Content="Export MusicXML…"/>
      <Button Name="MergeButton" Classes="tool" Content="Merge versions…" ToolTip.Tip="Compare and merge several versions of the same music (editions, a part and the score)"/>
      <Border Width="1" Background="#808080" Margin="6,2"/>
      <RadioButton Name="SelectMode" GroupName="mode" Content="Select" IsChecked="True"/>
      <RadioButton Name="AddNoteMode" GroupName="mode" Content="Add note"/>
      <RadioButton Name="AddRestMode" GroupName="mode" Content="Add rest"/>
      <RadioButton Name="AddBarlineMode" GroupName="mode" Content="Add bar line"/>
      <RadioButton Name="MoveMode" GroupName="mode" Content="Move"/>
      <Border Width="1" Background="#808080" Margin="6,2"/>
      <CheckBox Name="StaffLinesCheck" Content="Staff lines" IsChecked="True"/>
      <CheckBox Name="BarlinesCheck" Content="Bar lines" IsChecked="True"/>
      <CheckBox Name="BoxesCheck" Content="Boxes" IsChecked="True"/>
      <CheckBox Name="LabelsCheck" Content="Labels" IsChecked="True"/>
      <CheckBox Name="FitsCheck" Content="Duration check" IsChecked="True"/>
      <TextBlock VerticalAlignment="Center" FontSize="11" Margin="4,0,0,0" ToolTip.Tip="Note head colours by duration">
        <Run Text="heads:" Foreground="Gray"/>
        <Run Text=" whole" Foreground="#828282"/><Run Text=" half" Foreground="#E6AA00"/><Run Text=" 4th" Foreground="#00B400"/>
        <Run Text=" 8th" Foreground="#00AAD2"/><Run Text=" 16th" Foreground="#2846EB"/><Run Text=" 32nd" Foreground="#AA28D2"/><Run Text=" 64th" Foreground="#EB2882"/>
      </TextBlock>
      <Border Width="1" Background="#808080" Margin="6,2"/>
      <Button Name="FitButton" Classes="tool" Content="Fit"/>
      <Button Name="FitWidthButton" Classes="tool" Content="Fit width"/>
      <Button Name="Zoom100Button" Classes="tool" Content="100%"/>
    </WrapPanel>
    <TextBlock DockPanel.Dock="Bottom" Name="StatusText" Margin="8,3" Text="Open a PDF or an image to start."/>

    <Grid ColumnDefinitions="*,4,380">
      <local:PageView Name="View" Grid.Column="0"/>
      <GridSplitter Grid.Column="1" Background="#C0C0C0" ResizeDirection="Columns"/>
      <ScrollViewer Grid.Column="2" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="10,0,10,10" Spacing="4">

          <TextBlock Classes="h" Text="Staff"/>
          <TextBlock Name="StaffInfo" TextWrapping="Wrap" Text="Click a staff or a symbol."/>
          <Grid ColumnDefinitions="60,*" RowDefinitions="Auto,Auto,Auto" Margin="0,4,0,0">
            <TextBlock Classes="lbl" Grid.Row="0" Grid.Column="0" Text="Clef"/>
            <ComboBox Name="StaffClefBox" Grid.Row="0" Grid.Column="1" HorizontalAlignment="Stretch" Margin="0,2"/>
            <TextBlock Classes="lbl" Grid.Row="1" Grid.Column="0" Text="Key"/>
            <ComboBox Name="StaffKeyBox" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch" Margin="0,2"/>
            <TextBlock Classes="lbl" Grid.Row="2" Grid.Column="0" Text="Time"/>
            <TextBox Name="StaffTimeBox" Grid.Row="2" Grid.Column="1" Watermark="auto, e.g. 3/4 or C" Margin="0,2"/>
          </Grid>
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Button Name="ApplyStaffButton" Content="Apply to staff"/>
            <Button Name="ClearStaffButton" Content="Back to automatic"/>
          </StackPanel>

          <TextBlock Classes="h" Text="Bar line"/>
          <TextBlock Name="BarlineInfo" TextWrapping="Wrap" Text="Click a bar line to select it; 'Add bar line' adds one where you click."/>
          <Grid ColumnDefinitions="60,*" Margin="0,4,0,0">
            <TextBlock Classes="lbl" Grid.Column="0" Text="Type"/>
            <ComboBox Name="BarKindBox" Grid.Column="1" HorizontalAlignment="Stretch" Margin="0,2"/>
          </Grid>
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Button Name="ApplyBarButton" Content="Apply"/>
            <Button Name="DeleteBarButton" Content="Delete bar line"/>
          </StackPanel>

          <TextBlock Classes="h" Text="Symbol"/>
          <TextBlock Name="SymbolInfo" TextWrapping="Wrap" FontFamily="Consolas,Courier New,monospace" FontSize="12" Text="(none)"/>
          <Grid ColumnDefinitions="60,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" Margin="0,4,0,0">
            <TextBlock Classes="lbl" Grid.Row="0" Grid.Column="0" Text="Kind"/>
            <ComboBox Name="KindBox" Grid.Row="0" Grid.Column="1" HorizontalAlignment="Stretch" Margin="0,2"/>
            <TextBlock Classes="lbl" Grid.Row="1" Grid.Column="0" Text="Duration"/>
            <ComboBox Name="DurationBox" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch" Margin="0,2"/>
            <TextBlock Classes="lbl" Grid.Row="2" Grid.Column="0" Text="Dots"/>
            <NumericUpDown Name="DotsBox" Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="3" Increment="1" FormatString="0" Margin="0,2"/>
            <TextBlock Classes="lbl" Grid.Row="3" Grid.Column="0" Text="Stem"/>
            <ComboBox Name="StemBox" Grid.Row="3" Grid.Column="1" HorizontalAlignment="Stretch" Margin="0,2"/>
            <TextBlock Classes="lbl" Grid.Row="4" Grid.Column="0" Text="Time"/>
            <TextBox Name="SymTimeBox" Grid.Row="4" Grid.Column="1" Watermark="makes it a time signature, e.g. 3/8 or C" Margin="0,2"/>
          </Grid>
          <TextBlock Text="Note heads" Margin="0,6,0,0"/>
          <StackPanel Name="HeadsPanel" Spacing="2"/>
          <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,6,0,0">
            <Button Name="ApplySymbolButton" Content="Apply"/>
            <Button Name="DeleteSymbolButton" Content="Delete symbol"/>
          </StackPanel>

          <TextBlock Classes="h" Text="Measures to check"/>
          <TextBlock Name="FitSummary" TextWrapping="Wrap" Text=""/>
          <ListBox Name="FitList" Height="150" FontFamily="Consolas,Courier New,monospace" FontSize="11"/>

          <TextBlock Classes="h" Text="Symbols in this measure"/>
          <TextBlock Name="MeasureFitText" TextWrapping="Wrap" Text=""/>
          <ListBox Name="MeasureList" Height="230" FontFamily="Consolas,Courier New,monospace" FontSize="11"/>

          <TextBlock Classes="h" Text="Corrections"/>
          <TextBlock Name="CorrectionsInfo" TextWrapping="Wrap" Text="Corrections are saved next to the score and replayed when the page is recognised again."/>
          <ScrollViewer MaxHeight="220" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Name="CorrectionsList" Spacing="1"/>
          </ScrollViewer>
          <Button Name="DiscardPageButton" Content="Discard this page's corrections" Margin="0,4,0,0"/>

          <TextBlock Classes="h" Text="Notes and warnings"/>
          <TextBox Name="NotesBox" AcceptsReturn="True" IsReadOnly="True" Height="180" TextWrapping="Wrap" FontSize="11"/>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </DockPanel>
</Window>
